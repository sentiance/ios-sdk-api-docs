xt":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Enables SDK detections. Requires a Sentiance user to be present on the device."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Enabling detections is persistent across app restarts. Therefore, you do not need to call this method on every app"},{"type":"text","text":" "},{"type":"text","text":"startup. Once detections are enabled, as long as the SDK is properly initialized during startup, detections will be"},{"type":"text","text":" "},{"type":"text","text":"resumed, until you disable them by calling disableDetections."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Enabling detections does not mean that the SDK is successfully able to start all detections. There may be"},{"type":"text","text":" "},{"type":"text","text":"unsatisfactory conditions that are blocking some detections. Check the detection status returned in the result to"},{"type":"text","text":" "},{"type":"text","text":"see if detections are running, and the SDK status to identify possible causes if not."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To automatically disable detections after some time, use the enableDetectionsWithExpiryDate: variant of this method."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/sentsdk\/sentiance\/enabledetections(completionhandler:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/sentsdk\/sentiance\/enabledetections(completionhandler:)"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance\/enableDetections(completionHandler:)"},"kind":"symbol","metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableDetections","kind":"identifier"},{"text":"(","kind":"text"},{"text"