{"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance"]]},"identifier":{"url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance\/getTimelineUpdates(after:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Returns all updated events in the event timeline after the specified date, sorted by the last update time."},{"type":"text","text":" "},{"type":"text","text":"The events will not include provisional ones (see: "},{"code":"SENTTimelineEvent.isProvisional","type":"codeVoice"},{"type":"text","text":")."}],"variants":[{"paths":["\/documentation\/sentsdk\/sentiance\/gettimelineupdates(after:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/sentsdk\/sentiance\/gettimelineupdates(after:)"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getTimelineUpdates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"after"},{"kind":"text","text":" "},{"kind":"internalParam","text":"date"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTTimelineEvent","text":"SENTTimelineEvent","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTTimelineEvent"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"date","content":[{"type":"paragraph","inlineContent":[{"text":"The date to retrieve updates from. The specified date is exclusive.","type":"text"}]}]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method returns all events that started after the date, but it may also return events"},{"type":"text","text":" "},{"type":"text","text":"that started before the date, if they were updated afterwards. The returned result is not"},{"type":"text","text":" "},{"type":"text","text":"necessarily the complete list of events that were captured by the SDK from the result’s first event until the"},{"type":"text","text":" "},{"type":"text","text":"last, because events that were not updated will be excluded. To get a complete and ordered list of"},{"type":"text","text":" "},{"type":"text","text":"events for a given date range, use getTimelineEvents(from dateFrom: Date, to dateTo: Date) instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use this method along with eventTimelineDelegate to stay up to date with the latest events in"},{"type":"text","text":" "},{"type":"text","text":"the timeline. For example, to make sure you don’t miss out on timeline updates, you can first set the delegate,"},{"type":"text","text":" "},{"type":"text","text":"then follow up by using this method to query for potential updates since the last update you received."}]}],"kind":"content"}],"metadata":{"externalID":"c:@CM@SENTSDK@@objc(cs)Sentiance(im)getTimelineUpdatesAfter:","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getTimelineUpdates"},{"kind":"text","text":"("},{"kind":"externalParam","text":"after"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTTimelineEvent","text":"SENTTimelineEvent"},{"kind":"text","text":"]"}],"modules":[{"name":"SENTSDK"}],"extendedModule":"SENTSDK","title":"getTimelineUpdates(after:)","symbolKind":"method","navigatorTi