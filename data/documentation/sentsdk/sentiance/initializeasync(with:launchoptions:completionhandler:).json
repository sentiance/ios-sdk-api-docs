"kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]},{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initializeAsync","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"options","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"SENTOptions","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTOptions","preciseIdentifier":"c:objc(cs)SENTOptions","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"launchOptions","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"AnyHashable","preciseIdentifier":"s:s11AnyHashableV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> (","kind":"text"},{"text":"SENTAsyncInitializationResult","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTAsyncInitializationResult","preciseIdentifier":"c:objc(cs)SENTAsyncInitializationResult","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"SENTAsyncInitializationError","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTAsyncInitializationError","preciseIdentifier":"c:objc(cs)SENTAsyncInitializationError","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The SDK initialization options.","type":"text"}],"type":"paragraph"}],"name":"options"},{"content":[{"inlineContent":[{"text":"The launch options obtained from [AppDelegate application:application","type":"text"},{"text":" ","type":"text"},{"text":"didFinishLaunchingWithOptions:launchOptions]","type":"text"}],"type":"paragraph"}],"name":"launchOptions"},{"content":[{"inlineContent":[{"text":"The handler that will receive a SENTAsyncInitializationResult object if initialization","type":"text"},{"text":" ","type":"text"},{"text":"succeeds, and a SENTAsyncInitializationError object if it fails.","type":"text"}],"type":"paragraph"}],"name":"completionHandler"}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Asynchronously initializes the Sentiance SDK.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Asynchronously initializes the Sentiance SDK, thereby preparing it to resume detections if a Sentiance user exists","type":"text"},{"text":" ","type":"text"},{"text":"and if detections were last enabled. If a user does not exist, this method does only minimal work to allow user","type":"text"},{"text":" ","type":"text"},{"text":"creation. To create a user, call createUserWithOptions:completionHandler:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is the asynchronous variant of the initializeWithOptions:launchOptions: method. Use this variant if you want","type":"text"},{"text":" ","type":"text"},{"text":"to minimize the impact of the SDK initialization on the startup duration of your app. However, note that","type":"text"},{"text":" ","type":"text"},{"text":"interacting with most Sentiance SDK APIs requires an initialized SDK. Therefore, make sure to handle a delayed or","type":"text"},{"text":" ","type":"text"},{"text":"failed initialization in other parts of your app, by utilizing the result returned to the completion handler.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To ensure proper continuity of SDK detections across app restarts, this method must still be called on the main","type":"text"},{"text":" ","type":"text"},{"text":"thread, inside [AppDelegate application:application didFinishLaunchingWithOptions:launchOptions], before it returns.","type":"text"},{"text":" ","type":"text"},{"text":"This method must not be called asynchronously, as doing so does not guarantee that it will be invoked before","type":"text"},{"text":" ","type":"text"},{"text":"application:didFinishLaunchingWithOptions: completes.","type":"text"},{"text":" ","type":"text"},{"text":"For more details on this, see: https:\/\/docs.sentiance.com\/important-topics\/sdk\/appendix\/sdk-async-initialization","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"Most SDK methods require an initialized SDK before being invoked, otherwise they throw a runtime exception.","type":"text"},{"text":" ","type":"text"},{"text":"Methods excluded from this requirement mention this in their respective documentation.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"inlineContent":[{"text":"fail with reason SENTInitializationFailureReasonReinitializationNotAllowed, unless a user does not exist yet (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"before user creation or after an SDK reset), in which case multiple initializations are still allowed.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance"]]},"metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initializeAsync","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SENTOptions","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTOptions"},{"text":", ","kind":"text"},{"text":"launchOptions","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"AnyHashable","kind":"typeIdentifier","preciseIdentifier":"s:s11AnyHashableV"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"]?, ","kind":"text"},{"text":"completionHandler","kind":"externalP