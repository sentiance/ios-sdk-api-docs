ifier"},{"text":" : ","kind":"text"},{"kind":"keyword","text":"Any"},{"kind":"text","text":"]? = nil) "},{"kind":"keyword","text":"async"},{"text":" -> (","kind":"text"},{"text":"SENTAsyncInitializationResult","kind":"typeIdentifier","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTAsyncInitializationResult","preciseIdentifier":"c:objc(cs)SENTAsyncInitializationResult"},{"kind":"text","text":"?, "},{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTAsyncInitializationError","kind":"typeIdentifier","text":"SENTAsyncInitializationError","preciseIdentifier":"c:objc(cs)SENTAsyncInitializationError"},{"text":"?)","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK initialization options."}]}],"name":"options"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The launch options obtained from [AppDelegate application:application"},{"type":"text","text":" "},{"type":"text","text":"didFinishLaunchingWithOptions:launchOptions]"}]}],"name":"launchOptions"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler that will receive a SENTAsyncInitializationResult object if initialization"},{"type":"text","text":" "},{"text":"succeeds, and a SENTAsyncInitializationError object if it fails.","type":"text"}]}],"name":"completionHandler"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Asynchronously initializes the Sentiance SDK."}]},{"type":"paragraph","inlineContent":[{"text":"Asynchronously initializes the Sentiance SDK, thereby preparing it to resume detections if a Sentiance user exists","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and if detections were last enabled. If a user does not exist, this method does only minimal work to allow user"},{"type":"text","text":" "},{"type":"text","text":"creation. To create a user, call createUserWithOptions:completionHandler:"}]},{"type":"paragraph","inlineContent":[{"text":"This is the asynchronous variant of the initializeWithOptions:launchOptions: method. Use this variant if you want","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to minimize the impact of the SDK initialization on the startup duration of your app. However, note that"},{"text":" ","type":"text"},{"type":"text","text":"interacting with most Sentiance SDK APIs requires an initialized SDK. Therefore, make sure to handle a delayed or"},{"type":"text","text":" "},{"text":"failed initialization in other parts of your app, by utilizing the result returned to the completion handler.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To ensure proper continuity of SDK detections across app restarts, this method must still be called on the main","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"thread, inside [AppDelegate application:application didFinishLaunchingWithOptions:launchOptions], before it returns."},{"type":"text","text":" "},{"type":"text","text":"This method must not be called asynchronously, as doing so does not guarantee that it will be invoked before"},{"type":"text","text":" "},{"type":"text","text":"application:didFinishLaunchingWithOptions: completes."},{"type":"text","text":" "},{"type":"text","text":"For more details on this, see: https:\/\/docs.sentiance.com\/important-topics\/sdk\/appendix\/sdk-async-initialization"}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Most SDK methods require an initialized SDK before being invoked, otherwise they throw a runtime exception."},{"type":"text","text":" "},{"type":"text","text":"Methods excluded from this requirement mention this in their respective documentation."}]}],"style":"note","type":"aside"},{"type":"paragrap