ror","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingError","preciseIdentifier":"c:objc(cs)SENTUserLinkingError"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")? = nil)"}]},{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkUser"},{"kind":"text","text":"("},{"kind":"externalParam","text":"authCode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> ("},{"kind":"typeIdentifier","text":"SENTUserLinkingResult","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingResult","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult"},{"kind":"text","text":"?, "},{"kind":"typeIdentifier","text":"SENTUserLinkingError","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingError","preciseIdentifier":"c:objc(cs)SENTUserLinkingError"},{"kind":"text","text":"?)"}]}]},{"kind":"parameters","parameters":[{"name":"authCode","content":[{"inlineContent":[{"text":"A code obtained from the backend Sentiance API.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Links the Sentiance user to your app’s user, on the Sentiance Cloud Platform.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Uses the supplied authentication code to find the app user. Therefore, before calling this method, make sure that you","type":"text"},{"text":" ","type":"text"},{"text":"have obtained a valid code from the backend Sentiance API (thereby having initiated the first linking step). This","type":"text"},{"text":" ","type":"text"},{"text":"code request is authenticated using a Sentiance API key, which must never be transmitted to the app. Hence why the","type":"text"},{"text":" ","type":"text"},{"text":"request must come from your backend.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Here are the complete steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Retrieve the code in your app and supply it to this method.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Initiate an authentication code request via your backend towards the Sentiance backend. This request will include","type":"text"},{"text":" ","type":"text"},{"text":"your app’s user identifier, which will be temporarily coupled to the code that you will receive.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The SDK will forward the code to the Sentiance backend to complete the link.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"name":"Note","content":[{"inlineContent":[{"text":"With this method, a Sentiance user cannot be linked to an app user that already exists on the Sentiance","type":"text"},{"text":" ","type":"text"},{"text":"Platform (i.e. with an app user identifier that you already supplied to Sentiance during a past authentication code","type":"text"},{"text":" ","type":"text"},{"text":"request). You can only link to an app user that is new to Sentiance. This is because an existing app user will","type":"text"},{"text":" ","type":"text"},{"text":"already have a corresponding Sentiance user on the platform, and that Sentiance user cannot be restored here anymore.","type":"text"},{"text":" ","type":"text"},{"text":"To restore that user, you must reset the SDK and recreate a linked Sentiance user instead.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"inlineContent":[{"text":"This method is useful if you want to link a Sentiance user that was previously created without specifying a linker","type":"text"},{"text":" ","type":"text"},{"text":"in the user creation options (thereby having created an unlinked user).","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance"]]},"sections":[],"variants":[{"paths":["\/documentation\/sentsdk\/sentiance\/linkuser(authcode:completionhandler:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/sentsdk\/sentiance\/linkuser(authcode:completionhandler:)"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance\/linkUser(authCode:completionHandler:)"},"references":{"doc://com.sentiance.SENTSDK/documentation/SENTSDK/Sentiance/linkUser(authCode:completionHandler:)":{"role":"symbol","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"linkUserWithAuthCode:completionHandler:"}],"url":"\/documentation\/sentsdk\/sentiance\/linkuser(authcode:completionhandler:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkUser"},{"kind":"text","text":"("},{"kind":"externalParam","text":"authCode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"completionHandler"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult","text":"SENTUserLinkingResult"},{"kind":"text","text":"?, "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingError","text":"SENTUserLinkingError"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")?)"}],"type":"topic","title":"linkUser(authCode:completionHandler:)","identifier":"doc:\/\/co