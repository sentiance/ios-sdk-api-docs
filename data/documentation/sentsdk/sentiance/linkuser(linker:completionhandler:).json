serLinkingResult","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult"},{"text":"?, ","kind":"text"},{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingError","text":"SENTUserLinkingError","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingError"},{"text":"?) -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")? = nil)","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]},{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkUser","kind":"identifier"},{"text":"(","kind":"text"},{"text":"linker","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker","text":"SENTUserLinker","kind":"typeIdentifier","preciseIdentifier":"c:SENTUserLinker.h@T@SENTUserLinker"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> (","kind":"text"},{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingResult","text":"SENTUserLinkingResult","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult"},{"text":"?, ","kind":"text"},{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingError","text":"SENTUserLinkingError","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SENTUserLinkingError"},{"text":"?)","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"parameters":[{"name":"linker","content":[{"type":"paragraph","inlineContent":[{"text":"The linker that the SDK will pass the installation ID to.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Links the Sentiance user to your app’s user on the Sentiance Cloud Platform."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"During the linking process, the SDK will invoke the supplied SENTUserLinker, and will pass to it an installation ID."},{"type":"text","text":" "},{"type":"text","text":"Your app must then forward this installation ID to the Sentiance backend (via your backend), and initiate user"},{"type":"text","text":" "},{"type":"text","text":"linking. Finally, when the linking completes, you must invoke the proper linker callback to complete the process."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here are the complete steps:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this method and supply a linker."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your linker will be invoked during the process, and an installation ID will be supplied."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your linker, forward the installation ID to your backend to initiate a linking request towards the Sentiance"},{"type":"text","text":" "},{"type":"text","text":"backend. This request will include the installation ID and your app’s user identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the response from the Sentiance backend and forward the result to the app."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Based on the result, invoke the linker callback’s success or failure method. The callback is supplied to  your"},{"type":"text","text":" "},{"type":"text","text":"linker along with the installation ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it was successful, the SDK will confirm the result with the Sentiance backend to complete the link."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This method is useful if you want to link a Sentiance user that was created without specifying a linker in the user"},{"type":"text","text":" "},{"type":"text","text":"creation options (thereby having created an unlinked user)."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"With this method, a Sentiance user cannot be linked to an app user that already exists on the Sentiance","type":"text"},{"text":" ","type":"text"},{"text":"Platform (i.e. with an app user identifier that you already supplied to Sentiance during a past linking request).","type":"text"},{"text":" ","type":"text"},{"text":"You can only link to an app user that is new to Sentiance. This is because an existing app user will already have a","type":"text"},{"text":" ","type":"text"},{"text":"corresponding Sentiance user on the platform, and that Sentiance user cannot be restored here anymore. To restore","type":"text"},{"text":" ","type":"text"},{"text":"that user, you must reset the SDK and recreate a linked Sentiance user instead.","type":"text"}]}],"style":"note","name":"Note","type":"aside"}]}],"identifier":{"url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance\/linkUser(linker:completionHandler:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sentsdk\/sentiance\/linkuser(linker:completionhandler:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/sentsdk\/sentiance\/linkuser(linker:completionhandler:)"]}],"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance"]]},"sections":[],"kind":"symbol","references":{"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTUserLinker":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"SENTUserLinker","kind":"identifier"}],"title":"SENTUserLinker","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker","u