serLinker","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> ("},{"kind":"typeIdentifier","text":"SENTUserLinkingResult","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingResult"},{"kind":"text","text":"?, "},{"kind":"typeIdentifier","text":"SENTUserLinkingError","preciseIdentifier":"c:objc(cs)SENTUserLinkingError","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinkingError"},{"kind":"text","text":"?)"}]}]},{"parameters":[{"name":"linker","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The linker that the SDK will pass the installation ID to."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Links the Sentiance user to your app’s user on the Sentiance Cloud Platform."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"During the linking process, the SDK will invoke the supplied SENTUserLinker, and will pass to it an installation ID."},{"type":"text","text":" "},{"type":"text","text":"Your app must then forward this installation ID to the Sentiance backend (via your backend), and initiate user"},{"type":"text","text":" "},{"type":"text","text":"linking. Finally, when the linking completes, you must invoke the proper linker callback to complete the process."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Here are the complete steps:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this method and supply a linker."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your linker will be invoked during the process, and an installation ID will be supplied."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your linker, forward the installation ID to your backend to initiate a linking request towards the Sentiance"},{"type":"text","text":" "},{"type":"text","text":"backend. This request will include the installation ID and your app’s user identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the response from the Sentiance backend and forward the result to the app."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Based on the result, invoke the linker callback’s success or failure method. The callback is supplied to  your"},{"type":"text","text":" "},{"type":"text","text":"linker along with the installation ID."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it was successful, the SDK will confirm the result with the Sentiance backend to complete the link."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This method is useful if you want to link a Sentiance user that was created without specifying a linker in the user"},{"type":"text","text":" "},{"type":"text","text":"creation options (thereby having created an unlinked user)."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With this method, a Sentiance user cannot be linked to an app user that already exists on the Sentiance"},{"type":"text","text":" "},{"type":"text","text":"Platform (i.e. with an app user identifier that you already supplied to Sentiance during a past linking request)."},{"type":"text","text":" "},{"type":"text","text":"You can only link to an app user that is new to Sentiance. This is because an existing app user will already have a"},{"type":"text","text":" "},{"type":"text","text":"corresponding Sentiance user on the platform, and that Sentiance user cannot be restored here anymore. To restore"},{"type":"text","text":" "},{"type":"text","text":"that user, you must reset the SDK and recreate a linked Sentiance user instead."}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"linkUser","kind":"identifier"},{"text":"(","kind":"text"},{"text":"linker","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SENTUserLinker","preciseIdentifier":"c:SENTUserLinker.h@T@SENTUserLinker","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"completionHandler","kind":"externalParam"},{"text":": ((","kind":"text"},{"text":"SENTUserLinkingResult","preciseIdentifier":"c:objc(cs)SENTUserLinkingResult","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"SENTUserLinkingError","preciseIdentifier":"c:objc(cs)SENTUserLinkingError","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")?)","kind":"text"}],"role":"symbol","modules":[{"name":"SENTSDK"}],"externalID":"c:objc(cs)Sentiance(im)linkUserWithLinker:completionHandler:","roleHeading":"Instance Method","symbolKind":"method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"linkUserWithLinker:completionHandler:","kind":"identifier"}],"title":"linkUser(linker:completionHandler:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/Sentiance\/linkUser(linker:completionHandler:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://com.sentiance.SENTSDK/documentation/SENTSDK":{"abstract":[{"type":"text","text":"The Sentiance iOS SDK."}],"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","url":"\/documentation\/sentsdk","title":"SENTSDK","role":"collection","type":"topic","kind":"symbol"},"doc://com.sentiance.SENTSDK/documentation/SENTSDK