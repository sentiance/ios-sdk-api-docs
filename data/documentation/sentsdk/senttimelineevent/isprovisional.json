{"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTTimelineEvent"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isProvisional","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"A provisional event is identified based on real-time detections, but may change in the near","type":"text"},{"text":" ","type":"text"},{"text":"future as more data is collected and processed, to filter out unwanted artifacts. For","type":"text"},{"text":" ","type":"text"},{"text":"example, a provisional car transport may get identified, followed by a provisional bus","type":"text"},{"text":" ","type":"text"},{"text":"transport. After the full trip is complete, these provisional events may get merged into","type":"text"},{"text":" ","type":"text"},{"text":"a single final car event.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Final events are generated independently of the provisional events, and have unique","type":"text"},{"text":" ","type":"text"},{"text":"event IDs. They are not linked to the provisional events they may resemble, replace,","type":"text"},{"text":" ","type":"text"},{"text":"or overlap with.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Currently, provisional events apply only to ‘transport’ types, as the SDK tries to","type":"text"},{"text":" ","type":"text"},{"text":"determine the mode of transport in (near) real time. When the full trip is complete","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. the user becomes stationary), the collected data is reprocessed to produce a","type":"text"},{"text":" ","type":"text"},{"text":"more accurate and cleaned up list of transport events.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sentsdk\/senttimelineevent\/isprovisional"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/sentsdk\/senttimelineevent\/isprovisional"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTTimelineEvent\/isProvisional","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Indicates whether the event is provisional."}],"kind":"symbol","metadata":{"symbolKind":"property","externalID":"c:objc(cs)SENTTimelineEvent(py)isProvisional","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isProvisional"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"roleHeading":"Instance Property","modules":[{"name":"SENTSDK"}],"title":"isProvisional","navigatorTitle":[{"text":"isProvisional","kind":"identifier"}]},"sections":[],"references":{"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTTimelineEvent/isProvisional":{"type":"topic","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTTimelineEvent\/isProvisional","abstract":[{"type":"text","text":"Indicates whether the event is provisional."}],"title":"isProvisional","kind":"symbol","url":"\/documentation\/sentsdk\/senttimelineevent\/isprovisional","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"isProvisional"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isProvisional"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://com.sentiance.SENTSDK/documentation/SENTSDK":{"tit