{"metadata":{"symbolKind":"init","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithAppId:secret:linker:","kind":"identifier"}],"externalID":"c:objc(cs)SENTUserCreationOptions(im)initWithAppId:secret:linker:","title":"init(appId:secret:linker:)","roleHeading":"Initializer","role":"symbol","modules":[{"name":"SENTSDK"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"appId","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"secret","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"linker","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:SENTUserLinker.h@T@SENTUserLinker","text":"SENTUserLinker","kind":"typeIdentifier"},{"text":"?)","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions\/init(appId:secret:linker:)"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"appId","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"secret","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"linker","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SENTUserLinker","kind":"typeIdentifier","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker","preciseIdentifier":"c:SENTUserLinker.h@T@SENTUserLinker"},{"text":"? = nil)","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"– Your Sentiance app ID."}]}],"name":"appId"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"– Your Sentiance app secret."}]}],"name":"secret"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"– Linker which will be invoked to initiate user linking. When nil, an unlinked user will be created"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}],"name":"linker"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Accepts Sentiance app credentials and a linker, to create a linked Sentiance user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"During the user creation process, the SDK will call the link method of the supplied SENTUserLinker, and will pass to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"it an installation ID. Your app must then forward this installation ID to the Sentiance backend (via your backend),"},{"type":"text","text":" "},{"type":"text","text":"and initiate user linking. Finally, when the linking completes, you must invoke the proper linker callback to"},{"type":"text","text":" "},{"type":"text","text":"complete the process."}]},{"type":"paragraph","inlineContent":[{"text":"Here are the complete steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this initializer and supply your Sentiance app credentials and a linker. Your linker will be invoked during"},{"type":"text","text":" "},{"type":"text","text":"the user creation process, and an installation ID will be supplied."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your linker, forward the installation ID to your backend to initiate a linking request towards the Sentiance"},{"type":"text","text":" "},{"type":"text","text":"backend. This request will include the installation ID and your app’s user identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the response from the Sentiance backend and forward the result to the app."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Based on the result, invoke the linker callback’s success or failure method. The callback is supplied to your"},{"type":"text","text":" "},{"type":"text","text":"linker along with the installation ID. If it was successful, the SDK will confirm the result with the Sentiance"},{"type":"text","text":" "},{"type":"text","text":"backend to complete the user creation."}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create an unlinked (anonymous) Sentiance user by specifying a nil linker. After doing so, you can link"},{"type":"text","text":" "},{"type":"text","text":"the user at a later time by calling linkUserWithLinker:completionHandler or linkUserWithAuthCode:completionHandler"},{"type":"text","text":" "},{"type":"text","text":"on the Sentiance class. However, note that linking this way has certain limitations. An unlinked user cannot be"},{"type":"text","text":" "},{"type":"text","text":"linked to an app user that already exists on the Sentiance Platform (i.e. with an app user identifier that you"},{"type":"text","text":" "},{"type":"text","text":"already supplied to Sentiance during a past linking request). You can only link to an app user that is new to"},{"type":"text","text":" "},{"type":"text","text":"Sentiance. This is because an existing app user will already have a corresponding Sentiance user on the platform,"},{"type":"text","text":" "},{"type":"text","text":"and that Sentiance user cannot be restored here anymore. To restore that user, you must reset the SDK and recreate a"},{"type":"text","text":" "},{"type":"text","text":"linked Sentiance user instead."}]}],"name":"Note","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sentsdk\/sentusercreationoptions\/init(appid:secret:linker:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/sentsdk\/sentusercreationoptions\/init(appid:secret:linker:)"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions"]]},"references":{"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTUserCreationOptions":{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SENTUserCreationOptions","kind":"identifier"}],"abstract":[],"type":"topic","title":"SENTUserCreationOptions","role":"symbol","navigatorTitle":[{"text":"SENTUserCreationOptions","kind":"identifier"}],"url":"\/documentation\/sentsdk\/sentusercreationoptions"},"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTUserLinker":{"identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SENTUserLinker","kind":"identifier"}],"abstract":[{"type":"text","text":"Implement this to handle the linking of your app user to a Sentiance user, during user creation."},{"type":"text","text":" "},{"type":"text","text":"For details on how to link users, see https:\/\/docs.sentiance.com\/important-topics\/sdk\/appendix\/user-linking"}],"type":"topic","title":"SENTUserLinker","role":"symbol","navigatorTitle":[{"text":"SENTUserLinker","kind":"identifier"}],"url":"\/documentation\/sentsdk\/sentuserlinker"},"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTUserCreationOptions/init(appId:secret:linker:)":{"abstract":[],"url":"\/documentation\/sentsdk\/sentusercreationoptions\/init(appid:se