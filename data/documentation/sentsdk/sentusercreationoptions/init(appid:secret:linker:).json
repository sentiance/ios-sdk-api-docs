Options":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SENTUserCreationOptions"}],"title":"SENTUserCreationOptions","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions","url":"\/documentation\/sentsdk\/sentusercreationoptions","abstract":[],"role":"symbol","navigatorTitle":[{"text":"SENTUserCreationOptions","kind":"identifier"}]},"doc://com.sentiance.SENTSDK/documentation/SENTSDK/SENTUserLinker":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"SENTUserLinker","kind":"identifier"}],"title":"SENTUserLinker","identifier":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserLinker","url":"\/documentation\/sentsdk\/sentuserlinker","abstract":[{"type":"text","text":"Implement this to handle the linking of your app user to a Sentiance user, during user creation."},{"text":" ","type":"text"},{"text":"For details on how to link users, see https:\/\/docs.sentiance.com\/important-topics\/sdk\/appendix\/user-linking","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"SENTUserLinker","kind":"identifier"}]}},"variantOverrides":[{"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/metadata\/platforms","value":null,"op":"add"},{"path":"\/metadata\/roleHeading","value":"Instance Method","op":"replace"},{"path":"\/metadata\/title","value":"initWithAppId:secret:linker:","op":"replace"},{"path":"\/metadata\/symbolKind","value":"method","op":"replace"},{"path":"\/metadata\/fragments","value":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithAppId:secret:linker:"}],"op":"replace"},{"path":"\/topicSections","value":null,"op":"add"},{"path":"\/relationshipsSections","value":null,"op":"add"},{"path":"\/seeAlsoSections","value":null,"op":"add"},{"path":"\/primaryContentSections\/0","value":{"kind":"declarations","declarat