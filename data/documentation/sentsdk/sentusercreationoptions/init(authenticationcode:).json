{"hierarchy":{"paths":[["doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK","doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.sentiance.SENTSDK\/documentation\/SENTSDK\/SENTUserCreationOptions\/init(authenticationCode:)"},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/sentsdk\/sentusercreationoptions\/init(authenticationcode:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/sentsdk\/sentusercreationoptions\/init(authenticationcode:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"authenticationCode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"authenticationCode","content":[{"type":"paragraph","inlineContent":[{"text":"– a code obtained from the backend Sentiance API.","type":"text"}]}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Accepts an authentication code, which will be used to create a linked Sentiance user.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The supplied authentication code is used to find the app user to link to during the user creation process. Therefore,"},{"type":"text","text":" "},{"type":"text","text":"before calling this method, make sure that you have obtained a valid code from the backend Sentiance API. This code"},{"type":"text","text":" "},{"type":"text","text":"request is authenticated using a Sentiance API key, which must never be transmitted to the app. Hence why the request"},{"type":"text","text":" "},{"type":"text","text":"must come from your backend."}]},{"inlineContent":[{"text":"Here are the complete steps:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initiate an authentication code request via your backend towards the Sentiance backend. This request will include","type":"text"},{"text":" ","type":"text"},{"text":"your app’s user identifier, which will be temporarily coupled to the code that you will receive.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Retrieve the code in your app and supply it to this initializer.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Build and pass a SENTUserCreationOptions object containing this code to createUserWithOptions:completionHandler:","type":"text"},{"text":" ","type":"text"},{"text":"to create a linked user. If the authentication code references an app user that exists on the Sentiance Platform","type":"text"},{"text":" ","type":"text"},{"text":"(i.e. an app user identifier that was previously supplied to Sentiance), its corresponding Sentiance user will be","type":"text"},{"text":" ","type":"text"},{"text":"restored on this device. Any other SDK instance with this user will then get disabled.","type":"text"}]}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"authenticationCode","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithAuthenticationCode:","kind":"identifier"}],"externalID":"c:objc(cs)SENTUserCreationOptions(im)initWithAuthenticationCode:","modules":[{"name":"SENTSDK"}],"title":"init(authenticationCode:)","symbolKind":"init","role":"symbol"},"references":{"doc://com.sentiance.SENTSD